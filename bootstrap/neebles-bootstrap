#!/bin/bash

set -u

MODE="${1:---interactive}"

BOSS_BOOTSTRAP_URL="https://github.com/krockzs/neebles-boss/releases/latest/download/bootstrap.json"
NEEBLES_BIN="/opt/neebles/client/bin/neebles"

case "$MODE" in
    --interactive|--headless)
        ;;
    *)
        exit 1
        ;;
esac

TMPDIR="$(mktemp -d)"
BOOTSTRAP="$TMPDIR/bootstrap.json"
PLAN="$TMPDIR/assets.tsv"
INFO="$TMPDIR/stable.txt"

cleanup() {
    rm -rf "$TMPDIR"
}

trap cleanup EXIT

fail() {
    echo "[N.E.E.B.L.E.S.] $1" >&2

    if [ "$MODE" = "--interactive" ] && command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$1"
    fi

    exit 1
}

echo "[N.E.E.B.L.E.S.] Consultando N.E.E.B.L.E.S. Boss..."

curl -LfsS \
    --proto '=https' \
    --tlsv1.2 \
    --connect-timeout 4 \
    --max-time 20 \
    "$BOSS_BOOTSTRAP_URL" \
    -o "$BOOTSTRAP" \
    || fail "No fue posible obtener bootstrap.json de Boss."

python3 - "$BOOTSTRAP" "$PLAN" "$INFO" <<'PY' \
    || fail "Bootstrap Schema 2 de Boss inválido."

import json
import re
import sys

bootstrap_path, plan_path, info_path = sys.argv[1:]

with open(bootstrap_path, encoding="utf-8") as f:
    data = json.load(f)

if data.get("schema") != 2:
    raise SystemExit(1)

if data.get("channel") != "stable":
    raise SystemExit(1)

stable = data.get("stable")

if not isinstance(stable, dict):
    raise SystemExit(1)

version = stable.get("version")
base_url = stable.get("base_url")
assets = stable.get("assets")

if not isinstance(version, str) or not re.fullmatch(r"\d+\.\d+\.\d+", version):
    raise SystemExit(1)

if not isinstance(base_url, str) or not base_url.startswith("https://"):
    raise SystemExit(1)

if not isinstance(assets, dict):
    raise SystemExit(1)

required = (
    "backend",
    "ui",
    "installer",
    "auth_agent",
    "client_data",
    "install",
)

if set(assets) != set(required):
    raise SystemExit(1)

validated = {}

for asset_id in required:
    asset = assets.get(asset_id)

    if not isinstance(asset, dict):
        raise SystemExit(1)

    filename = asset.get("file")
    sha256 = asset.get("sha256")

    if not isinstance(filename, str) or not filename:
        raise SystemExit(1)

    if "/" in filename or "\\" in filename:
        raise SystemExit(1)

    if not isinstance(sha256, str) or not re.fullmatch(r"[0-9a-fA-F]{64}", sha256):
        raise SystemExit(1)

    validated[asset_id] = (
        filename,
        sha256.lower(),
    )

with open(info_path, "w", encoding="utf-8") as f:
    f.write(version + "\n")
    f.write(base_url + "\n")

with open(plan_path, "w", encoding="utf-8") as f:
    for asset_id in required:
        filename, sha256 = validated[asset_id]
        f.write(
            f"{asset_id}\t"
            f"{filename}\t"
            f"{sha256}\n"
        )
PY

mapfile -t INFO_DATA < "$INFO"

[ "${#INFO_DATA[@]}" -eq 2 ] \
    || fail "Contrato estable de Boss incompleto."

STABLE_VERSION="${INFO_DATA[0]}"
BASE_URL="${INFO_DATA[1]}"

version_lt() {
    [ "$1" != "$2" ] && \
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}

if [ -x "$NEEBLES_BIN" ]; then
    LOCAL_VERSION="$("$NEEBLES_BIN" --version 2>/dev/null | awk '{print $NF}')" \
        || fail "No fue posible determinar la versión local de Boss."

    if ! [[ "$LOCAL_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        fail "La versión local de Boss es inválida: ${LOCAL_VERSION}"
    fi

    if ! version_lt "$LOCAL_VERSION" "$STABLE_VERSION"; then
        echo "[N.E.E.B.L.E.S.] Boss ${LOCAL_VERSION} listo."
        exec "$NEEBLES_BIN"
    fi

    echo "[N.E.E.B.L.E.S.] Actualización disponible: ${LOCAL_VERSION} -> ${STABLE_VERSION}"
else
    echo "[N.E.E.B.L.E.S.] Boss no instalado. Preparando ${STABLE_VERSION}..."
fi

declare -A ASSET_PATHS

while IFS=$'\t' read -r asset_id filename expected_sha; do
    destination="$TMPDIR/$filename"

    echo "[N.E.E.B.L.E.S.] Descargando ${filename}..."

    curl -LfsS \
        --proto '=https' \
        --tlsv1.2 \
        --connect-timeout 4 \
        --max-time 120 \
        "${BASE_URL}/${filename}" \
        -o "$destination" \
        || fail "No fue posible descargar ${filename}."

    actual_sha="$(sha256sum "$destination" | awk '{print $1}')"

    [ "$actual_sha" = "$expected_sha" ] \
        || fail "La verificación SHA-256 falló para ${filename}."

    ASSET_PATHS["$asset_id"]="$destination"
done < "$PLAN"

for executable_id in backend ui installer auth_agent install; do
    chmod 700 "${ASSET_PATHS[$executable_id]}" \
        || fail "No fue posible preparar ${executable_id}."
done

BACKEND="${ASSET_PATHS[backend]}"
UI="${ASSET_PATHS[ui]}"
INSTALLER="${ASSET_PATHS[installer]}"
AUTH_AGENT="${ASSET_PATHS[auth_agent]}"
CLIENT_DATA="${ASSET_PATHS[client_data]}"
INSTALL="${ASSET_PATHS[install]}"

echo "[N.E.E.B.L.E.S.] Ejecutando Boss ${STABLE_VERSION}..."

if [ "$MODE" = "--interactive" ]; then
    NEEBLES_AUTH_AGENT="$AUTH_AGENT" \
        "$INSTALLER" \
        "$INSTALL" \
        "$BACKEND" \
        "$UI" \
        "$CLIENT_DATA" \
        || fail "La instalación o actualización de Boss falló."
else
    "$INSTALL" \
        "$BACKEND" \
        "$UI" \
        "$CLIENT_DATA" \
        "$AUTH_AGENT" \
        || fail "La instalación o actualización de Boss falló."
fi

[ -x "$NEEBLES_BIN" ] \
    || fail "Boss no quedó instalado correctamente."

echo "[N.E.E.B.L.E.S.] Boss ${STABLE_VERSION} listo."

exec "$NEEBLES_BIN"
